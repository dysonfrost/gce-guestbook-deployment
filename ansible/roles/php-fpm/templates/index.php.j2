<?php
/**
 * Guestbook hit counter. Managed by Ansible. Local edits will be overwritten.
 */
declare(strict_types=1);

// nginx routes unmatched URIs here; count only real page views.
const APP_ROUTES = ['/', '/index.php'];

$requestPath = parse_url((string) ($_SERVER['REQUEST_URI'] ?? '/'), PHP_URL_PATH);
$isPageView = $requestPath !== null && in_array($requestPath, APP_ROUTES, true);

$redis = new Redis();

try {
    $redis->connect('{{ guestbook_redis_socket }}');
    $redis->setOption(Redis::OPT_READ_TIMEOUT, 2.0);
    $hits = $isPageView
        ? $redis->incr('{{ guestbook_redis_key }}')
        : $redis->get('{{ guestbook_redis_key }}');
} catch (RedisException $e) {
    http_response_code(503);
    header('Content-Type: text/plain; charset=utf-8');
    printf("Guestbook is temporarily unavailable.\n");
    error_log('guestbook: redis error: ' . $e->getMessage());
    exit(1);
}
?>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Guestbook</title>
</head>
<body>
  <h1>Guestbook</h1>
  <p>Hostname: <code><?= htmlspecialchars(gethostname(), ENT_QUOTES, 'UTF-8') ?></code></p>
  <p>Total hits: <strong><?= htmlspecialchars((string) $hits, ENT_QUOTES, 'UTF-8') ?></strong></p>
</body>
</html>
